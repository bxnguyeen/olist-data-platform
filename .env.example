# MinIO credentials used by Docker Compose and Python
MINIO_ROOT_USER=olist_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# PostgreSQL connection used by Python
PGHOST=localhost
PGPORT=5432
PGDATABASE=olist_database
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# Local directory containing the source CSV files
SOURCE_DATA_DIR=./data/source